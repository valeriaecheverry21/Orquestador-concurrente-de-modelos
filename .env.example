# Copia este archivo como .env y completa tus claves. Nunca subas .env a GitHub.

# --- Claves de API (al menos una) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Proveedor a usar en main.py: openai | anthropic | all ---
LLM_PROVIDER=all

# --- Opcionales (si se omiten se usan los valores por defecto) ---
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_TEMPERATURE=0.7      # 0 a 2 (solo OpenAI; la API actual de Anthropic no lo admite)
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60           # segundos por petición
# LLM_MAX_RETRIES=3        # reintentos ante rate limit / errores de red / 5xx
